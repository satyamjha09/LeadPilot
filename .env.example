# Legacy Google API credentials for local backwards compatibility only.
# Production must use the sender-specific variables below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_AUTH_EMAIL=demo.tallykonnect@gmail.com
GMAIL_FROM_EMAIL=demo.tallykonnect@gmail.com
GMAIL_FROM_NAME=TallyKonnect
ALLOW_LEGACY_GOOGLE_ENV=false

# Explicit Google sender account credentials. These are separate from the email template brand selector.
GOOGLE_TALLYKONNECT_CLIENT_ID=
GOOGLE_TALLYKONNECT_CLIENT_SECRET=
GOOGLE_TALLYKONNECT_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_TALLYKONNECT_AUTH_EMAIL=demo.tallykonnect@gmail.com
# Optional emergency fallback only. Prefer database OAuth connection.
GOOGLE_TALLYKONNECT_REFRESH_TOKEN=

GOOGLE_ANYWHERETALLY_CLIENT_ID=
GOOGLE_ANYWHERETALLY_CLIENT_SECRET=
GOOGLE_ANYWHERETALLY_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_ANYWHERETALLY_AUTH_EMAIL=info.anywheretally@gmail.com
GMAIL_ANYWHERETALLY_FROM_EMAIL=info.anywheretally@gmail.com
# Optional emergency fallback only. Prefer database OAuth connection.
GOOGLE_ANYWHERETALLY_REFRESH_TOKEN=

# Optional legacy refresh-token aliases. Prefer the sender-specific variables above.
GOOGLE_REFRESH_TOKEN=

# Public app origins. APP_ORIGIN is also used to reject cross-origin mutations.
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=0

# Operator login/session configuration. Create operators only with npm run operator:create.
OPERATOR_SESSION_TTL_HOURS=12
OPERATOR_IDLE_TTL_MINUTES=120
OPERATOR_COOKIE_NAME=leadpilot_session
OPERATOR_BOOTSTRAP_EMAIL=
OPERATOR_BOOTSTRAP_PASSWORD=
OPERATOR_BOOTSTRAP_DISPLAY_NAME=

# PostgreSQL database for demo state, history, and duplicate prevention
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/tallykonnect_dev?schema=public"

# Legacy server-only admin tokens. Normal frontend does not use these.
# Keep ALLOW_LEGACY_ADMIN_TOKENS=false unless temporarily debugging server-to-server access.
ALLOW_LEGACY_ADMIN_TOKENS=false
ADMIN_RESET_TOKEN=

# Optional background processing queue. Keep disabled until Redis and a worker are configured.
PROCESS_QUEUE_ENABLED=false
PROCESS_QUEUE_CONCURRENCY=1
REDIS_URL=redis://localhost:6379

# Future multi-source architecture flag. Phase 1 creates the database foundation only.
MULTI_SOURCE_V2_ENABLED=false
MULTI_SOURCE_V2_ADMIN_TOKEN=

# Cloudflare R2 storage for permanent Excel sources
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto

# Multi-source ingestion safety
SOURCE_INGESTION_STALE_MINUTES=30
SOURCE_INGESTION_BATCH_SIZE=250
TEST_DATABASE_URL=

# Multi-source canonical lead matching
LEAD_MATCH_BATCH_SIZE=250
LEAD_MATCH_STALE_MINUTES=30
LEAD_MATCH_STRATEGY_VERSION=exact-v1
