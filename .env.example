# Google API Credentials for Excel Meet Scheduler
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Optional. If set, the app can use this refresh token until Clear Session is pressed.
GOOGLE_REFRESH_TOKEN=

# Optional. Used only when GOOGLE_REDIRECT_URI is not set.
APP_URL=http://localhost:3000

# PostgreSQL database for demo state, history, and duplicate prevention
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/tallykonnect_dev?schema=public"

# Optional background processing queue. Keep disabled until Redis and a worker are configured.
PROCESS_QUEUE_ENABLED=false
PROCESS_QUEUE_CONCURRENCY=1
REDIS_URL=redis://localhost:6379
