generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LeadSchedule {
  id              String   @id @default(cuid())
  fullName        String?
  email           String
  dateOfDemo      String
  timeOfDemo      String
  meetingLink     String?
  calendarEventId String?
  gmailMessageId  String?
  status          String   @default("Pending")
  remarks         String?
  sourceType      String?
  sourceId        String?
  sheetRowNumber  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([email, dateOfDemo, timeOfDemo])
}

model EmailLog {
  id        String   @id @default(cuid())
  email     String
  rowKey    String
  type      String
  status    String   @default("sent")
  messageId String?
  error     String?
  createdAt DateTime @default(now())

  @@unique([email, rowKey, type])
}
