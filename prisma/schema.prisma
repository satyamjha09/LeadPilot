generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LeadSchedule {
  id              String   @id @default(cuid())
  automationId    String?
  fullName        String?
  email           String
  dateOfDemo      String
  timeOfDemo      String
  meetingLink     String?
  calendarEventId String?
  gmailMessageId  String?
  status          String   @default("Pending")
  remarks         String?
  sourceType      String?
  sourceId        String?
  sheetRowNumber  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([automationId, dateOfDemo, timeOfDemo])
  @@index([email, dateOfDemo, timeOfDemo])
  @@index([automationId])
}

model CustomerDemoState {
  id                  String   @id @default(cuid())
  userId              String   @unique
  fullName            String?
  email               String
  status              String
  activeDemoSessionId String?
  meetingLink         String?
  calendarEventId     String?
  demoStartUtc        String?
  demoEndUtc          String?
  demoDate            String?
  demoTime            String?
  timezone            String?
  sourceType          String?
  sourceId            String?
  sheetRowNumber      Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  demoHistory DemoHistory[]

  @@index([status])
}

model DemoHistory {
  id                      String   @id @default(cuid())
  sessionId               String   @unique
  userId                  String
  fullName                String?
  email                   String
  status                  String
  scheduledStartUtc       String
  scheduledEndUtc         String
  displayDate             String
  displayTime             String
  timezone                String
  meetingLink             String
  calendarEventId         String
  rescheduleCount         Int      @default(0)
  scheduledEmailSentAt    String?
  reminder24HourSentAt    String?
  reminder1HourSentAt     String?
  demoDoneEmailSentAt     String?
  noResponseEmailSentAt   String?
  cancellationEmailSentAt String?
  scheduledAt             String
  completedAt             String?
  noResponseAt            String?
  cancelledAt             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  customer CustomerDemoState @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([email])
  @@index([status])
}

model EmailLog {
  id        String   @id @default(cuid())
  email     String
  rowKey    String
  type      String
  status    String   @default("sent")
  messageId String?
  error     String?
  createdAt DateTime @default(now())

  @@unique([email, rowKey, type])
}

model SheetLeadState {
  id              String   @id @default(cuid())
  sheetRowKey     String   @unique
  spreadsheetId   String
  sheetName       String
  sheetRowNumber  Int
  email           String?
  lastLeadStatus  String?
  lastMeetingDate String?
  lastMeetingTime String?
  lastMeetingLink String?
  lastAction      String?
  lastActionStatus String?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmailDelivery {
  id                String   @id @default(cuid())
  eventKey          String   @unique
  automationId      String
  emailType         String
  recipient         String
  payloadHash       String
  status            String   @default("PROCESSING")
  attemptCount      Int      @default(1)
  retryCount        Int      @default(0)
  maxRetries        Int      @default(3)
  nextRetryAt       DateTime?
  providerMessageId String?
  subject           String?
  textBody          String?
  htmlBody          String?
  sentAt            DateTime?
  lockedAt          DateTime?
  lockedBy          String?
  lastError         String?
  sheetSyncStatus   String?
  sheetSyncLastError String?
  sheetSyncRetryAt  DateTime?
  sheetSyncedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([automationId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([sheetSyncStatus])
  @@index([sheetSyncRetryAt])
  @@index([updatedAt])
}

model SheetSyncJob {
  id              String   @id @default(cuid())
  jobKey          String   @unique
  spreadsheetId   String
  sheetName       String
  rowNumber       Int
  headersJson     String
  valuesJson      String
  emailDeliveryId String?
  status          String   @default("PENDING")
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  nextRetryAt     DateTime @default(now())
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([nextRetryAt])
  @@index([emailDeliveryId])
}

model GoogleAuth {
  id           String    @id @default(cuid())
  email        String    @unique
  accessToken  String?
  refreshToken String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
