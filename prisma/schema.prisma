generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum DataSourceType {
  GOOGLE_SHEETS
  EXCEL
  CSV
}

enum DataSourceConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  ARCHIVED
}

enum SourceSnapshotStatus {
  CREATED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum SourceRowValidationStatus {
  VALID
  WARNING
  INVALID
}

enum SourceRowIdentityType {
  AUTOMATION_ID
  ROW_NUMBER
}

enum LeadIdentityType {
  EMAIL
  PHONE
  AUTOMATION_ID
  CRM_ID
}

enum LeadIdentitySource {
  AUTO
  MANUAL
  MIGRATION
}

enum LeadMatchStatus {
  UNMATCHED
  MATCHED
  CONFLICT
  SKIPPED
}

enum LeadMatchRunStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum LeadMatchResultStatus {
  CREATED
  MATCHED
  UNCHANGED
  CONFLICT
  SKIPPED
}

enum LeadMatchConflictStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum LeadMatchConflictType {
  MULTIPLE_LEADS
  IDENTITY_OWNED_BY_ANOTHER_LEAD
  LINKED_LEAD_CHANGED
  NO_STRONG_IDENTITY
  INVALID_IDENTITY
}

model Workspace {
  id        String          @id @default(cuid())
  key       String          @unique
  name      String
  status    WorkspaceStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  dataSources          DataSource[]
  sourceRows           SourceRow[]
  leads                Lead[]
  leadIdentities       LeadIdentity[]
  identityObservations LeadIdentityObservation[]
  leadMatchRuns        LeadMatchRun[]
  leadMatchConflicts   LeadMatchConflict[]
  leadMergeHistories   LeadMergeHistory[]
}

model DataSource {
  id               String         @id @default(cuid())
  workspaceId      String
  type             DataSourceType
  displayName      String
  externalFileId   String?
  originalFileName String?
  storageKey       String?
  mimeType         String?
  checksum         String?
  fileSize         Int?

  connectionStatus DataSourceConnectionStatus @default(CONNECTED)
  syncEnabled      Boolean                    @default(true)

  lastValidatedAt DateTime?
  lastSyncedAt    DateTime?
  lastSyncStatus  String?
  lastError       String?
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  tabs          DataSourceTab[]
  snapshots     SourceSnapshot[]
  rows          SourceRow[]
  leadMatchRuns LeadMatchRun[]

  @@unique([workspaceId, type, externalFileId])
  @@unique([workspaceId, type, checksum])
  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, connectionStatus])
}

model DataSourceTab {
  id            String  @id @default(cuid())
  dataSourceId  String
  externalTabId String
  name          String
  position      Int?
  isEnabled     Boolean @default(true)

  headerHash  String?
  headersJson Json
  rowCount    Int     @default(0)

  lastSyncedAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataSource   DataSource          @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  rows         SourceRow[]
  snapshots    SourceSnapshot[]
  tabResults   SourceSnapshotTab[]
  snapshotRows SourceSnapshotRow[]

  @@unique([dataSourceId, externalTabId])
  @@index([dataSourceId])
  @@index([dataSourceId, isEnabled])
}

model SourceSnapshot {
  id           String               @id @default(cuid())
  dataSourceId String
  sourceTabId  String?
  version      Int
  status       SourceSnapshotStatus @default(CREATED)
  trigger      String               @default("MANUAL")

  rowCount       Int @default(0)
  addedCount     Int @default(0)
  updatedCount   Int @default(0)
  unchangedCount Int @default(0)
  removedCount   Int @default(0)
  invalidCount   Int @default(0)

  checksum   String?
  rawFileKey String?
  error      String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  dataSource    DataSource          @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  sourceTab     DataSourceTab?      @relation(fields: [sourceTabId], references: [id], onDelete: SetNull)
  tabResults    SourceSnapshotTab[]
  snapshotRows  SourceSnapshotRow[]
  leadMatchRuns LeadMatchRun[]

  @@unique([dataSourceId, version])
  @@index([dataSourceId, createdAt])
  @@index([sourceTabId])
  @@index([status])
}

model SourceSnapshotTab {
  id          String               @id @default(cuid())
  snapshotId  String
  sourceTabId String
  status      SourceSnapshotStatus @default(PROCESSING)

  rowCount       Int @default(0)
  addedCount     Int @default(0)
  updatedCount   Int @default(0)
  unchangedCount Int @default(0)
  removedCount   Int @default(0)
  invalidCount   Int @default(0)

  headerHash  String?
  contentHash String?
  error       String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  snapshot  SourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sourceTab DataSourceTab  @relation(fields: [sourceTabId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, sourceTabId])
  @@index([snapshotId])
  @@index([sourceTabId])
  @@index([status])
}

model SourceSnapshotRow {
  id          String @id @default(cuid())
  snapshotId  String
  sourceTabId String

  externalRowId String
  rowNumber     Int
  identityType  SourceRowIdentityType

  rowHash        String
  rawData        Json
  normalizedData Json

  automationId String?
  email        String?
  phone        String?
  crmId        String?
  fullName     String?
  leadStatus   String?
  demoDate     String?
  demoTime     String?
  meetingLink  String?
  remarks      String?

  validationStatus SourceRowValidationStatus @default(VALID)
  validationErrors Json?

  createdAt DateTime @default(now())

  snapshot  SourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sourceTab DataSourceTab  @relation(fields: [sourceTabId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, sourceTabId, externalRowId])
  @@index([snapshotId, sourceTabId])
  @@index([sourceTabId, externalRowId])
  @@index([validationStatus])
}

model Lead {
  id               String    @id @default(cuid())
  workspaceId      String
  primaryEmail     String?
  normalizedEmail  String?
  fullName         String?
  status           String?
  mergedIntoLeadId String?
  mergedAt         DateTime?
  lastMatchedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourceRows           SourceRow[]
  identities           LeadIdentity[]
  mergedInto           Lead?               @relation("LeadMerge", fields: [mergedIntoLeadId], references: [id], onDelete: SetNull)
  mergedLeads          Lead[]              @relation("LeadMerge")
  matchResults         LeadMatchResult[]
  resolvedConflicts    LeadMatchConflict[]
  sourceMergeHistories LeadMergeHistory[]  @relation("LeadMergeHistorySource")
  targetMergeHistories LeadMergeHistory[]  @relation("LeadMergeHistoryTarget")

  @@unique([workspaceId, normalizedEmail])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, mergedIntoLeadId])
  @@index([normalizedEmail])
}

model LeadIdentity {
  id          String             @id @default(cuid())
  workspaceId String
  leadId      String
  type        LeadIdentityType
  scopeKey    String             @default("workspace")
  value       String
  source      LeadIdentitySource @default(AUTO)
  isVerified  Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  lead         Lead                      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  observations LeadIdentityObservation[]

  @@unique([workspaceId, type, scopeKey, value])
  @@index([leadId])
  @@index([leadId, type])
  @@index([workspaceId])
  @@index([workspaceId, type])
}

model SourceRow {
  id           String @id @default(cuid())
  workspaceId  String
  dataSourceId String
  sourceTabId  String

  externalRowId String
  rowNumber     Int?
  identityType  SourceRowIdentityType @default(ROW_NUMBER)
  rowHash       String

  rawData        Json
  normalizedData Json

  automationId String?
  email        String?
  phone        String?
  crmId        String?
  fullName     String?
  leadStatus   String?
  demoDate     String?
  demoTime     String?
  meetingLink  String?
  remarks      String?

  validationStatus SourceRowValidationStatus @default(VALID)
  validationErrors Json?

  canonicalLeadId          String?
  leadMatchStatus          LeadMatchStatus @default(UNMATCHED)
  leadMatchReason          String?
  leadMatchedAt            DateTime?
  leadMatchStrategyVersion String?

  isActive         Boolean   @default(true)
  lastSeenAt       DateTime  @default(now())
  firstSeenVersion Int?
  lastSeenVersion  Int?
  deactivatedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace            Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  dataSource           DataSource                @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  sourceTab            DataSourceTab             @relation(fields: [sourceTabId], references: [id], onDelete: Restrict)
  canonicalLead        Lead?                     @relation(fields: [canonicalLeadId], references: [id], onDelete: SetNull)
  matchResults         LeadMatchResult[]
  matchConflicts       LeadMatchConflict[]
  identityObservations LeadIdentityObservation[]

  @@unique([sourceTabId, externalRowId])
  @@index([workspaceId])
  @@index([workspaceId, leadMatchStatus])
  @@index([dataSourceId])
  @@index([sourceTabId, rowNumber])
  @@index([canonicalLeadId])
  @@index([canonicalLeadId, isActive])
  @@index([email])
  @@index([automationId])
  @@index([validationStatus])
}

model LeadIdentityObservation {
  id             String @id @default(cuid())
  workspaceId    String
  leadIdentityId String
  sourceRowId    String

  isActive    Boolean  @default(true)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  identity  LeadIdentity @relation(fields: [leadIdentityId], references: [id], onDelete: Restrict)
  sourceRow SourceRow    @relation(fields: [sourceRowId], references: [id], onDelete: Restrict)

  @@unique([leadIdentityId, sourceRowId])
  @@index([sourceRowId])
  @@index([workspaceId, isActive])
}

model LeadMatchRun {
  id              String             @id @default(cuid())
  workspaceId     String
  dataSourceId    String
  snapshotId      String
  strategyVersion String             @default("exact-v1")
  status          LeadMatchRunStatus @default(PROCESSING)

  rowCount          Int @default(0)
  createdLeadCount  Int @default(0)
  matchedRowCount   Int @default(0)
  unchangedRowCount Int @default(0)
  conflictCount     Int @default(0)
  skippedCount      Int @default(0)

  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  dataSource DataSource     @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  snapshot   SourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  results   LeadMatchResult[]
  conflicts LeadMatchConflict[]

  @@index([workspaceId, startedAt])
  @@index([dataSourceId, startedAt])
  @@index([snapshotId])
  @@index([status])
}

model LeadMatchResult {
  id          String                @id @default(cuid())
  runId       String
  sourceRowId String
  leadId      String?
  status      LeadMatchResultStatus

  reasonCode       String?
  identitiesJson   Json
  candidateLeadIds Json?

  createdAt DateTime @default(now())

  run       LeadMatchRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  sourceRow SourceRow    @relation(fields: [sourceRowId], references: [id], onDelete: Restrict)
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([runId, sourceRowId])
  @@index([sourceRowId])
  @@index([leadId])
  @@index([status])
}

model LeadMatchConflict {
  id          String                  @id @default(cuid())
  workspaceId String
  runId       String
  sourceRowId String
  type        LeadMatchConflictType
  status      LeadMatchConflictStatus @default(OPEN)

  identityClaims   Json
  candidateLeadIds Json
  message          String

  resolvedLeadId String?
  resolutionNote String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  run          LeadMatchRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  sourceRow    SourceRow    @relation(fields: [sourceRowId], references: [id], onDelete: Restrict)
  resolvedLead Lead?        @relation(fields: [resolvedLeadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([runId])
  @@index([sourceRowId])
}

model LeadMergeHistory {
  id           String @id @default(cuid())
  workspaceId  String
  sourceLeadId String
  targetLeadId String

  movedSourceRowCount Int
  movedIdentityCount  Int
  note                String?

  createdAt DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourceLead Lead      @relation("LeadMergeHistorySource", fields: [sourceLeadId], references: [id], onDelete: Restrict)
  targetLead Lead      @relation("LeadMergeHistoryTarget", fields: [targetLeadId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([sourceLeadId])
  @@index([targetLeadId])
}

model LeadSchedule {
  id              String   @id @default(cuid())
  emailBrand      String   @default("tallykonnect")
  automationId    String?
  fullName        String?
  email           String
  dateOfDemo      String
  timeOfDemo      String
  meetingLink     String?
  calendarEventId String?
  gmailMessageId  String?
  status          String   @default("Pending")
  remarks         String?
  sourceType      String?
  sourceId        String?
  sheetRowNumber  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([emailBrand, automationId, dateOfDemo, timeOfDemo])
  @@index([emailBrand])
  @@index([emailBrand, email, dateOfDemo, timeOfDemo])
  @@index([emailBrand, automationId])
  @@index([email, dateOfDemo, timeOfDemo])
  @@index([automationId])
}

model CustomerDemoState {
  id                  String   @id @default(cuid())
  emailBrand          String   @default("tallykonnect")
  userId              String
  fullName            String?
  email               String
  status              String
  activeDemoSessionId String?
  meetingLink         String?
  calendarEventId     String?
  demoStartUtc        String?
  demoEndUtc          String?
  demoDate            String?
  demoTime            String?
  timezone            String?
  sourceType          String?
  sourceId            String?
  sheetRowNumber      Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  demoHistory DemoHistory[]

  @@unique([emailBrand, userId])
  @@index([emailBrand])
  @@index([emailBrand, status])
  @@index([status])
}

model DemoHistory {
  id                      String   @id @default(cuid())
  emailBrand              String   @default("tallykonnect")
  sessionId               String   @unique
  userId                  String
  fullName                String?
  email                   String
  status                  String
  scheduledStartUtc       String
  scheduledEndUtc         String
  displayDate             String
  displayTime             String
  timezone                String
  meetingLink             String
  calendarEventId         String
  rescheduleCount         Int      @default(0)
  scheduledEmailSentAt    String?
  reminder24HourSentAt    String?
  reminder1HourSentAt     String?
  demoDoneEmailSentAt     String?
  noResponseEmailSentAt   String?
  cancellationEmailSentAt String?
  scheduledAt             String
  completedAt             String?
  noResponseAt            String?
  cancelledAt             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  customer CustomerDemoState @relation(fields: [emailBrand, userId], references: [emailBrand, userId])

  @@index([emailBrand])
  @@index([emailBrand, userId])
  @@index([emailBrand, email])
  @@index([emailBrand, status])
  @@index([userId])
  @@index([email])
  @@index([status])
}

model EmailLog {
  id         String   @id @default(cuid())
  emailBrand String   @default("tallykonnect")
  email      String
  rowKey     String
  type       String
  status     String   @default("sent")
  messageId  String?
  error      String?
  createdAt  DateTime @default(now())

  @@unique([emailBrand, email, rowKey, type])
  @@index([emailBrand])
}

model SheetLeadState {
  id               String   @id @default(cuid())
  emailBrand       String   @default("tallykonnect")
  sheetRowKey      String
  spreadsheetId    String
  sheetName        String
  sheetRowNumber   Int
  email            String?
  lastLeadStatus   String?
  lastMeetingDate  String?
  lastMeetingTime  String?
  lastMeetingLink  String?
  lastAction       String?
  lastActionStatus String?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([emailBrand, sheetRowKey])
  @@index([emailBrand])
  @@index([emailBrand, spreadsheetId, sheetName, sheetRowNumber])
}

model EmailDelivery {
  id                 String    @id @default(cuid())
  emailBrand         String    @default("tallykonnect")
  eventKey           String
  automationId       String
  emailType          String
  recipient          String
  payloadHash        String
  status             String    @default("PROCESSING")
  attemptCount       Int       @default(1)
  retryCount         Int       @default(0)
  maxRetries         Int       @default(3)
  nextRetryAt        DateTime?
  providerMessageId  String?
  subject            String?
  textBody           String?
  htmlBody           String?
  sentAt             DateTime?
  lockedAt           DateTime?
  lockedBy           String?
  lastError          String?
  sheetSyncStatus    String?
  sheetSyncLastError String?
  sheetSyncRetryAt   DateTime?
  sheetSyncedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([emailBrand, eventKey])
  @@index([emailBrand])
  @@index([emailBrand, automationId])
  @@index([emailBrand, status])
  @@index([automationId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([sheetSyncStatus])
  @@index([sheetSyncRetryAt])
  @@index([updatedAt])
}

model SheetSyncJob {
  id              String   @id @default(cuid())
  emailBrand      String   @default("tallykonnect")
  jobKey          String
  spreadsheetId   String
  sheetName       String
  rowNumber       Int
  headersJson     String
  valuesJson      String
  emailDeliveryId String?
  status          String   @default("PENDING")
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  nextRetryAt     DateTime @default(now())
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([emailBrand, jobKey])
  @@index([emailBrand])
  @@index([emailBrand, status])
  @@index([emailBrand, nextRetryAt])
  @@index([status])
  @@index([nextRetryAt])
  @@index([emailDeliveryId])
}

model GoogleAuth {
  id           String    @id @default(cuid())
  email        String    @unique
  accessToken  String?
  refreshToken String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WorkflowControl {
  id          String   @id
  generation  Int      @default(1)
  isResetting Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model ProcessLeadJob {
  id             String   @id @default(cuid())
  status         String   @default("QUEUED")
  generation     Int      @default(1)
  sourceType     String
  emailBrand     String   @default("tallykonnect")
  spreadsheetId  String?
  sheetName      String?
  headersJson    String?
  inputRowsJson  String
  resultRowsJson String?
  summaryJson    String?
  progressJson   String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([emailBrand])
  @@index([generation])
  @@index([createdAt])
}
